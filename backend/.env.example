ENVIRONMENT=local
DATABASE_URL=postgresql+psycopg://connectorhub:connectorhub@db:5432/connectorhub
FRONTEND_ORIGIN=http://localhost:3000
# Generate a key with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIAL_ENCRYPTION_KEY=
FIREBASE_PROJECT_ID=
# Google OAuth 2.0 Credentials (for Google Analytics 4 integration)
# Configure an OAuth 2.0 Web Application client in Google Cloud Console
# Authorized redirect URI: http://localhost:8000/api/v1/oauth/google/callback
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/oauth/google/callback
# Google Ads API Credentials
# Developer token from Google Ads Manager Account (MCC) -> Tools and Settings -> API Center
GOOGLE_ADS_DEVELOPER_TOKEN=your-google-ads-developer-token
GOOGLE_ADS_REDIRECT_URI=http://localhost:8000/api/v1/oauth/google-ads/callback
GOOGLE_ADS_API_VERSION=v26
# Meta Ads (Facebook & Instagram) API Credentials
# Configure a Meta App in Meta for Developers (https://developers.facebook.com)
# Products: Marketing API, Facebook Login
# Authorized redirect URI: http://localhost:8000/api/v1/oauth/meta-ads/callback
META_APP_ID=your-meta-app-id
META_APP_SECRET=your-meta-app-secret
META_REDIRECT_URI=http://localhost:8000/api/v1/oauth/meta-ads/callback
META_ADS_API_VERSION=v27.0
BIGQUERY_PROJECT_ID=
GCS_BUCKET=
